      "checkConstraints": {
        "products_category_check": {
          "name": "products_category_check",
          "value": "\"products\".\"category\" IN (\n        'eggs',\n        'fertilizer',\n        'culled_chicken',\n        'other'\n      )"
        },
        "products_base_unit_check": {
          "name": "products_base_unit_check",
          "value": "\"products\".\"base_unit\" IN ('rack', 'piece', 'sack', 'head')"
        },
        "products_price_per_base_unit_check": {
          "name": "products_price_per_base_unit_check",
          "value": "\"products\".\"price_per_base_unit\" >= 0"
        },
        "products_price_per_rack_check": {
          "name": "products_price_per_rack_check",
          "value": "\"products\".\"price_per_rack\" IS NULL OR \"products\".\"price_per_rack\" >= 0"
        },
        "products_current_stock_check": {
          "name": "products_current_stock_check",
          "value": "\"products\".\"current_stock\" >= 0"
        },
        "products_min_stock_threshold_check": {
          "name": "products_min_stock_threshold_check",
          "value": "\"products\".\"min_stock_threshold\" >= 0"
        },
        "products_category_base_unit_check": {
          "name": "products_category_base_unit_check",
          "value": "\n        (\"products\".\"category\" = 'eggs' AND \"products\".\"base_unit\" = 'piece')\n        OR\n        (\"products\".\"category\" = 'fertilizer' AND \"products\".\"base_unit\" = 'sack')\n        OR\n        (\"products\".\"category\" = 'culled_chicken' AND \"products\".\"base_unit\" = 'head')\n        OR\n        (\"products\".\"category\" = 'other')\n      "
        },
        "products_egg_configuration_check": {
          "name": "products_egg_configuration_check",
          "value": "\n        (\n          \"products\".\"category\" = 'eggs'\n          AND \"products\".\"rack_size\" IS NOT NULL\n          AND \"products\".\"rack_size\" > 0\n          AND \"products\".\"price_per_rack\" IS NOT NULL\n        )\n        OR\n        (\n          \"products\".\"category\" <> 'eggs'\n          AND \"products\".\"rack_size\" IS NULL\n          AND \"products\".\"price_per_rack\" IS NULL\n        )\n      "
        }
      }
