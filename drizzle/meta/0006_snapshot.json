      "checkConstraints": {
        "transactions_payment_method_check": {
          "name": "transactions_payment_method_check",
          "value": "\"transactions\".\"payment_method\" IN ('cash', 'qris')"
        },
        "transactions_status_check": {
          "name": "transactions_status_check",
          "value": "\"transactions\".\"status\" IN ('paid', 'cancelled')"
        },
        "transactions_created_by_role_check": {
          "name": "transactions_created_by_role_check",
          "value": "\"transactions\".\"created_by_role\" IN ('owner', 'officer')"
        },
        "transactions_cancelled_by_role_check": {
          "name": "transactions_cancelled_by_role_check",
          "value": "\n        \"transactions\".\"cancelled_by_role\" IS NULL\n        OR \"transactions\".\"cancelled_by_role\" IN ('owner', 'officer')\n      "
        },
        "transactions_total_amount_check": {
          "name": "transactions_total_amount_check",
          "value": "\"transactions\".\"total_amount\" > 0"
        },
        "transactions_amount_paid_check": {
          "name": "transactions_amount_paid_check",
          "value": "\"transactions\".\"amount_paid\" >= 0"
        },
        "transactions_change_amount_check": {
          "name": "transactions_change_amount_check",
          "value": "\"transactions\".\"change_amount\" >= 0"
        },
        "transactions_payment_amounts_check": {
          "name": "transactions_payment_amounts_check",
          "value": "\n        (\n          \"transactions\".\"payment_method\" = 'cash'\n          AND \"transactions\".\"amount_paid\" >= \"transactions\".\"total_amount\"\n          AND \"transactions\".\"change_amount\"\n            = \"transactions\".\"amount_paid\" - \"transactions\".\"total_amount\"\n        )\n        OR\n        (\n          \"transactions\".\"payment_method\" = 'qris'\n          AND \"transactions\".\"amount_paid\" = \"transactions\".\"total_amount\"\n          AND \"transactions\".\"change_amount\" = 0\n        )\n      "
        },
        "transactions_cancellation_reason_check": {
          "name": "transactions_cancellation_reason_check",
          "value": "\n        \"transactions\".\"cancellation_reason\" IS NULL\n        OR \"transactions\".\"cancellation_reason\" IN (\n          'wrong_quantity',\n          'wrong_product',\n          'wrong_payment_method',\n          'customer_cancelled',\n          'other'\n        )\n      "
        },
        "transactions_cancellation_state_check": {
          "name": "transactions_cancellation_state_check",
          "value": "\n        (\n          \"transactions\".\"status\" = 'paid'\n          AND \"transactions\".\"cancelled_by_user_id\" IS NULL\n          AND \"transactions\".\"cancelled_by_name\" IS NULL\n          AND \"transactions\".\"cancelled_by_role\" IS NULL\n          AND \"transactions\".\"cancelled_at\" IS NULL\n          AND \"transactions\".\"cancellation_reason\" IS NULL\n          AND \"transactions\".\"cancellation_note\" IS NULL\n        )\n        OR\n        (\n          \"transactions\".\"status\" = 'cancelled'\n          AND \"transactions\".\"cancelled_by_name\" IS NOT NULL\n          AND \"transactions\".\"cancelled_by_role\" IS NOT NULL\n          AND \"transactions\".\"cancelled_at\" IS NOT NULL\n          AND \"transactions\".\"cancellation_reason\" IS NOT NULL\n        )\n      "
        },
        "transactions_other_cancellation_note_check": {
          "name": "transactions_other_cancellation_note_check",
          "value": "\n        \"transactions\".\"status\" <> 'cancelled'\n        OR \"transactions\".\"cancellation_reason\" <> 'other'\n        OR (\n          \"transactions\".\"cancellation_note\" IS NOT NULL\n          AND length(trim(\"transactions\".\"cancellation_note\")) > 0\n        )\n      "
        }
      }
